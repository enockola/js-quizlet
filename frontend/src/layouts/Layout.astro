---
import Navbar from '../components/Navbar.astro';

const { title = 'JavaScript Quizlet' } = Astro.props;
---

<style is:global>
  @import '../styles/global.css';
</style>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Navbar />
    <slot />
  </body>
</html>
