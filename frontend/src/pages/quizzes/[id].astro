---
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return Array.from({ length: 300 }, (_, index) => ({ params: { id: String(index + 1) } }));
}

const { id } = Astro.params;
---

<Layout title="Quiz details">
  <main class="page">
    <div class="container">
      <a href="/quizzes" class="muted">← Back to quizzes</a>
      <div id="page-data" data-id={id}></div>
      <section class="card" style="margin-top: 1rem;">
        <div id="quiz-details">Loading quiz…</div>
      </section>
      <section class="card question-preview-card is-hidden" id="question-preview" aria-labelledby="question-preview-title">
        <h2 id="question-preview-title">Questions in this quiz</h2>
        <ol id="question-preview-list" class="question-preview-list"></ol>
      </section>
    </div>
  </main>
</Layout>

<script type="module">
  import { getQuiz } from '../../lib/api.js';

  const quizId = document.getElementById('page-data')?.dataset.id;
  const container = document.getElementById('quiz-details');
  const questionPreview = document.getElementById('question-preview');
  const questionPreviewList = document.getElementById('question-preview-list');

  function difficultyClass(difficulty) {
    return `difficulty-${String(difficulty || '').toLowerCase()}`;
  }

  function escapeHtml(value) {
    return String(value || '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  async function loadQuiz() {
    try {
      const quiz = await getQuiz(quizId);
      container.innerHTML = `
        <h1>${escapeHtml(quiz.title)}</h1>
        <p class="muted">${escapeHtml(quiz.description || '')}</p>
        <div class="toolbar" style="margin-bottom:1rem;">
          <span class="badge ${difficultyClass(quiz.difficulty)}">${escapeHtml(quiz.difficulty)}</span>
          <span class="badge">${quiz.questions?.length || 0} questions</span>
        </div>
        <a class="btn" href="/take/${quiz.id}">Start this quiz</a>
      `;

      questionPreviewList.innerHTML = (quiz.questions || [])
        .map((question) => `<li>${escapeHtml(question.questionText)}</li>`)
        .join('');
      questionPreview.classList.toggle('is-hidden', !quiz.questions?.length);

    } catch {
      container.innerHTML = '<p>Unable to load the quiz right now.</p>';
    }
  }
  loadQuiz();
</script>
