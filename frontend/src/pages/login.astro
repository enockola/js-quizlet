---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Login">
  <main class="page">
    <div class="container">
      <section class="card" style="max-width: 560px; margin: 0 auto;">
        <h1>Login</h1>
        <p class="muted">Log in to manage your dashboard and save quizzes.</p>
        <form id="login-form">
          <div class="field">
            <label>Email</label>
            <input name="email" type="email" required />
          </div>
          <div class="field">
            <label>Password</label>
            <input name="password" type="password" required />
          </div>
          <button class="btn" type="submit">Log in</button>
        </form>
        <p style="margin-top: 1rem;"><a href="/register">Create an account</a></p>
      </section>
    </div>
  </main>
</Layout>

<script type="module">
  import { login } from '../lib/api.js';
  const form = document.getElementById('login-form');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    try {
      await login({ email: data.get('email'), password: data.get('password') });
      window.location.href = '/dashboard';
    } catch (error) {
      alert(error.message);
    }
  });
</script>
