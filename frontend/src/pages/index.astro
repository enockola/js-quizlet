---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <main>
    <section class="hero">
      <div class="container">
        <div class="stack" style="max-width: 840px;">
          <span class="badge dark">JavaScript Quizlet MVP</span>
          <h1>Study JavaScript with focused quizzes.</h1>
          <p>Browse public quizzes, review answers, and master key concepts with lightweight study sessions.</p>
          <div class="toolbar">
            <a class="btn" href="/quizzes">Browse quizzes</a>
            <a class="btn secondary auth-only is-hidden" href="/create">Create quiz</a>
            <a class="btn secondary guest-only" href="/login">Log in to create</a>
            <button class="btn ghost auth-only is-hidden" id="seed-button" type="button">Seed fallback</button>
          </div>
          <p class="muted" id="seed-status"></p>
        </div>
      </div>
    </section>

    <section class="page">
      <div class="container">
        <div class="split" style="margin-bottom: 1rem;">
          <h2>Featured quizzes</h2>
          <a class="muted" href="/quizzes">View all</a>
        </div>
        <div class="grid grid-2" id="featured-quizzes">
          <div class="card">Loading quizzes...</div>
        </div>
      </div>
    </section>

    <section class="page auth-only is-hidden" id="dashboard-section">
      <div class="container">
        <div class="stack">
          <div class="split">
            <div>
              <h2>Your quizzes</h2>
              <p class="muted">Manage the quizzes you created while keeping the public study tools on this same page.</p>
            </div>
            <a class="btn" href="/create">Create quiz</a>
          </div>
          <div id="dashboard-status" class="muted"></div>
          <div class="grid grid-2" id="dashboard-list"></div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script type="module">
  import { deleteQuiz, getMyQuizzes, getQuizzes, getToken, getUser, seedData } from '../lib/api.js';

  const quizContainer = document.getElementById('featured-quizzes');
  const status = document.getElementById('seed-status');
  const seedButton = document.getElementById('seed-button');
  const dashboardStatus = document.getElementById('dashboard-status');
  const dashboardList = document.getElementById('dashboard-list');
  const user = getToken() ? getUser() : null;

  function syncAuthState() {
    document.querySelectorAll('.auth-only').forEach((element) => {
      element.classList.toggle('is-hidden', !user);
    });
    document.querySelectorAll('.guest-only').forEach((element) => {
      element.classList.toggle('is-hidden', Boolean(user));
    });
  }

  async function loadFeatured() {
    try {
      const quizzes = await getQuizzes();
      quizContainer.innerHTML = quizzes.slice(0, 2).map((quiz) => `
        <article class="card">
          <div class="badge">${quiz.topic}</div>
          <h3>${quiz.title}</h3>
          <p class="muted">${quiz.description || ''}</p>
          <div class="toolbar" style="margin: 0.75rem 0;">
            <span class="badge">${quiz.difficulty}</span>
            <span class="badge">${quiz.source}</span>
          </div>
          <div class="toolbar">
            <a class="btn secondary" href="/quizzes/${quiz.id}">View</a>
            <a class="btn" href="/take/${quiz.id}">Take quiz</a>
          </div>
        </article>
      `).join('');
    } catch (error) {
      quizContainer.innerHTML = `<div class="empty-state">${error.message}</div>`;
    }
  }

  function renderDashboard(quizzes) {
    if (!dashboardList) return;

    if (!quizzes.length) {
      dashboardList.innerHTML = '<div class="empty-state">No quizzes yet. Create your first quiz.</div>';
      return;
    }

    dashboardList.innerHTML = quizzes.map((quiz) => `
      <article class="card">
        <div class="badge">${quiz.topic}</div>
        <h3>${quiz.title}</h3>
        <p class="muted">${quiz.description || ''}</p>
        <div class="toolbar" style="margin: 0.75rem 0;">
          <span class="badge">${quiz.difficulty}</span>
          <span class="badge">${quiz.source}</span>
        </div>
        <div class="toolbar">
          <a class="btn secondary" href="/quizzes/${quiz.id}">Details</a>
          <a class="btn secondary" href="/edit/${quiz.id}">Edit</a>
          <button class="btn danger" data-delete="${quiz.id}">Delete</button>
        </div>
      </article>
    `).join('');

    document.querySelectorAll('[data-delete]').forEach((button) => {
      button.addEventListener('click', async () => {
        if (!confirm('Delete this quiz?')) return;
        const id = button.getAttribute('data-delete');
        await deleteQuiz(id);
        loadDashboard();
      });
    });
  }

  async function loadDashboard() {
    if (!user) return;
    if (dashboardStatus) dashboardStatus.textContent = 'Loading your quizzes...';
    try {
      const quizzes = await getMyQuizzes();
      renderDashboard(quizzes);
      if (dashboardStatus) dashboardStatus.textContent = `${quizzes.length} quizzes found`;
    } catch (error) {
      if (dashboardStatus) dashboardStatus.textContent = error.message;
      if (dashboardList) dashboardList.innerHTML = `<div class="empty-state">${error.message}</div>`;
    }
  }

  seedButton?.addEventListener('click', async () => {
    if (status) status.textContent = 'Seeding data...';
    try {
      const result = await seedData();
      if (status) status.textContent = result.message;
      await loadFeatured();
    } catch (error) {
      if (status) status.textContent = error.message;
    }
  });

  syncAuthState();
  loadFeatured();
  loadDashboard();
</script>
