---
const links = [
  { href: '/', label: 'Home' },
  { href: '/quizzes', label: 'Browse' }
];

const authLinks = [
  { href: '/create', label: 'Create Quiz' }
];
---

<nav class="navbar">
  <div class="container">
    <a href="/" class="brand">Quizlet MVP</a>
    <div class="nav-links">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      {authLinks.map((link) => <a href={link.href} class="auth-only is-hidden">{link.label}</a>)}
      <a href="/login" class="btn secondary guest-only auth-link" id="login-link">Login</a>
      <a href="/register" class="btn secondary guest-only auth-link" id="register-link">Register</a>
      <a href="/" class="btn secondary auth-link is-hidden" id="logout-link">Logout</a>
    </div>
  </div>
</nav>

<script>
  const token = window.localStorage.getItem('quizlet_token');
  const user = window.localStorage.getItem('quizlet_user');
  const loginLink = document.getElementById('login-link');
  const registerLink = document.getElementById('register-link');
  const logoutLink = document.getElementById('logout-link');
  const authOnlyElements = document.querySelectorAll('.auth-only');
  const guestOnlyElements = document.querySelectorAll('.guest-only');

  let parsedUser = null;

  if (token && user) {
    try {
      parsedUser = JSON.parse(user);
    } catch {
      window.localStorage.removeItem('quizlet_token');
      window.localStorage.removeItem('quizlet_user');
    }
  }

  if (token && parsedUser) {
    authOnlyElements.forEach((element) => element.classList.remove('is-hidden'));
    guestOnlyElements.forEach((element) => element.classList.add('is-hidden'));

    if (loginLink) loginLink.classList.add('is-hidden');
    if (registerLink) registerLink.classList.add('is-hidden');
    if (logoutLink) {
      logoutLink.textContent = `Logout - ${parsedUser.username || parsedUser.name || 'User'}`;
      logoutLink.classList.remove('is-hidden');
      logoutLink.addEventListener('click', (event) => {
        event.preventDefault();
        window.localStorage.removeItem('quizlet_token');
        window.localStorage.removeItem('quizlet_user');
        window.location.href = '/';
      });
    }
  }
</script>
